Algoritmo ValidarAprobacion
	Definir nota como Real 
	
	Escribir "Ingrese la calificacion fianl obtenido (0,0 - 10,0),";
	Leer nota;
	
	SI nota > 3.0 Entonces
		Escribir "¡Enhoabuena! Ha aprobado satisfactoriamente la asignatura.";
	FinSi
	
	Escribir "proceso de reporte de calificacion finalizado.";
	
FinAlgoritmo
